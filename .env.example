# ============================================================
# LNS Botz — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# App
APP_NAME="LNS Botz"
ENV=development
DEBUG=false
SECRET_KEY=your-secret-key-minimum-32-characters-long-change-this

# AI Providers — Gemini is primary (required), OpenAI optional (only for Whisper voice)
GEMINI_API_KEY=AQ...
OPENAI_API_KEY=       # optional
ANTHROPIC_API_KEY=    # optional
DEFAULT_MODEL=gemini-2.0-flash
FALLBACK_MODEL=gemini-1.5-flash

# Database (local Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/botdb

# Redis (local Docker)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Telegram (get from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://your-domain.com  # your public URL

# WhatsApp via Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Email (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password

# AWS (for S3, ECS deployment)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Razorpay (India / UPI — get from razorpay.com)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=

# PayPal (International — get from developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true   # set false in production

# Observability (optional but recommended)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=

# Vector DB (optional, for advanced memory)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Rate limits
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_DAY=5000
